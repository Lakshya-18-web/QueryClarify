# Copy to app/.env (or a project-root .env). Real environment variables win.
# ---- required
GOOGLE_API_KEY=
# Legacy MySQL password. NOT needed when MYSQL_RO_USER / MYSQL_RO_PASSWORD are set
# (see below); only used by the legacy fallback and the offline admin scripts.
MYSQL_PASSWORD=

# ---- MySQL (built-in Spider databases)
MYSQL_HOST=localhost
MYSQL_PORT=3306

# RECOMMENDED: a SELECT-only account limited to the built-in databases.
# Generate it with:  python -m app.hardening_tools mysql-grants
MYSQL_RO_USER=
MYSQL_RO_PASSWORD=

# LEGACY FALLBACK: used ONLY while MYSQL_RO_USER is empty. The web application
# then connects as MYSQL_USER (it defaults to "root" when unset!) with
# MYSQL_PASSWORD. That is an ADMINISTRATIVE account: the server logs a SECURITY
# warning at every start-up, and QC_REQUIRE_READONLY_MYSQL=true refuses it.
# Leave these commented out in any real deployment.
# MYSQL_USER=
# MYSQL_PASSWORD is defined in the "required" section above.

# Refuse to serve built-in databases unless MYSQL_RO_USER is a dedicated
# account (recommended for production; off by default for compatibility).
QC_REQUIRE_READONLY_MYSQL=false

# OFFLINE ADMIN SCRIPTS ONLY (load_*.py, fix_*.py, repair_*.py): a privileged
# account that may create databases. Never used by the web application. If these
# are empty the scripts fall back to MYSQL_USER/MYSQL_PASSWORD and say so.
MYSQL_ADMIN_USER=
MYSQL_ADMIN_PASSWORD=

# Which built-in databases may be queried (the allow-list). Optional: when
# unset, the list comes from data/builtin_databases.txt, then from the router
# index (ChromaDB "spiderman_databases"). System schemas (mysql,
# information_schema, performance_schema, sys) are always refused.
# QC_BUILTIN_DATABASES=college_3,car_1
# QC_BUILTIN_DATABASES_FILE=./data/builtin_databases.txt
QC_BUILTIN_CACHE_SECONDS=300

# Server-side limits applied to every built-in MySQL connection
QC_MYSQL_MAX_EXECUTION_MS=10000
# Server-side cap for SELECTs without their own LIMIT (app cap + 1)
QC_MYSQL_MAX_SELECT_ROWS=1001
QC_MYSQL_CONNECT_TIMEOUT=5
QC_MYSQL_READ_TIMEOUT=30
QC_MYSQL_WRITE_TIMEOUT=30

# ---- bring-your-own-database (all optional, defaults shown)
# Set to false for a SQLite-only deployment (no MySQL needed)
QC_ENABLE_BUILTIN_DBS=true
QC_DATA_DIR=./data
# IMPORTANT in production: any long random string. Changing it orphans
# existing uploaded databases (their owners can no longer access them).
QC_OWNER_SALT=change-me
QC_MAX_UPLOAD_BYTES=52428800
QC_MAX_UPLOAD_FILES=20
QC_MAX_TABLES=100
QC_MAX_COLUMNS=200
QC_MAX_ROWS_PER_TABLE=500000
QC_MAX_TOTAL_ROWS=2000000
QC_MAX_DATABASES_PER_OWNER=5
QC_MAX_BYTES_PER_OWNER=209715200
QC_USER_DB_TTL_DAYS=7
QC_QUERY_TIMEOUT_SECONDS=10
QC_MAX_RESULT_ROWS=1000
QC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
